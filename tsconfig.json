{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [
        "app/**/*.ts",
        "app/**/*.tsx",
        "components/**/*.ts",
        "components/**/*.tsx",
        "constants/**/*.ts",
        "contexts/**/*.ts",
        "contexts/**/*.tsx",
        "hooks/**/*.ts",
        "hooks/**/*.tsx",
        "lib/**/*.ts",
        "types/**/*.ts",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ],
    "exclude": ["backend-legacy-railway", "core", "supabase", "tests", "node_modules"]
}
