{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "tests/**/*.test.ts",
    "tests/e2e/{seed-league,data-latency-bench,soak,browser-smoke,browser-auth,browser-perf-smoke,browser-gameplay,browser-league-lifecycle,browser-lineup-gameplay,browser-playoff-gameplay,browser-rookie-draft-gameplay,browser-waiver-gameplay,browser-trade-gameplay,dynasty-release-final-gate,dynasty-ranking-rpc,static-web-server,fake-upstream,performance-budgets,multi-team-trade-db,production-readiness,prod-data-source-health,db-security-catalog,edge-internal-auth,local-secret-scan,perpetual-season,player-source-parity}.mjs",
    "tests/source-guard.ts",
    "vitest.config.ts",
    "app.json",
    "app/+html.tsx",
    "hooks/use-color-scheme.web.ts",
    "public/sw.js",
    "supabase/functions/**/index.ts",
    "supabase/functions/**/*.test.ts",
    "supabase/tests/db/scoring-corrections.ts",
    "supabase/tests/db/playoff-spans.ts",
    "supabase/tests/db/playoff-consumption.ts",
    "supabase/tests/db/playoff-boundary-races.ts",
    "supabase/tests/db/playoff-missing-stats.ts",
    "supabase/tests/db/season-boundary-pagination.ts",
    "supabase/tests/db/season-boundary-et.ts",
    "supabase/tests/db/correlated-worker.ts",
    "supabase/tests/db/live-ingestion-clock.ts",
    "supabase/tests/db/live-ingestion-provider.ts",
    "supabase/tests/db/live-ingestion-crash-worker.ts",
    "supabase/tests/db/stats-provider-status.ts",
    "supabase/tests/db/playoff-pending-corrections.ts",
    "supabase/tests/db/rollover-standings.ts",
    "supabase/tests/db/player-score-revisions.ts",
    "supabase/tests/db/bbref-completion.ts",
    "supabase/tests/db/cdn-completion.ts",
    "supabase/tests/db/retention-scoring.ts",
    "supabase/tests/db/game-stats-concurrency.ts",
    "supabase/tests/db/cdn-calendar-completeness.ts",
    "supabase/tests/db/bbref-player-completeness.ts",
    "supabase/tests/db/bbref-schedule-completeness.ts",
    "supabase/tests/db/player-name-parity.ts",
