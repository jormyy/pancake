{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "tests/**/*.test.ts",
    "tests/e2e/{seed-league,data-latency-bench,soak,browser-smoke,browser-auth,browser-perf-smoke,browser-gameplay,browser-league-lifecycle,browser-lineup-gameplay,browser-playoff-gameplay,browser-rookie-draft-gameplay,browser-waiver-gameplay,browser-trade-gameplay,dynasty-release-final-gate,dynasty-ranking-rpc,static-web-server,fake-upstream,performance-budgets,multi-team-trade-db,production-readiness,prod-data-source-health,db-security-catalog,edge-internal-auth,local-secret-scan}.mjs",
    "tests/source-guard.ts",
    "vitest.config.ts",
    "app.json",
    "app/+html.tsx",
    "hooks/use-color-scheme.web.ts",
    "public/sw.js",
    "supabase/functions/**/index.ts",
    "supabase/functions/**/*.test.ts"
  ],
  "project": [
    "**/*.{js,mjs,ts,tsx}"
  ],
  "ignore": [
    "core/cjs/**",
    "dist/**",
    "supabase/shared-src/**",
    "supabase/functions/_shared/date.ts",
    "supabase/functions/_shared/gameId.ts",
    "supabase/functions/_shared/livePoll.ts",
    "supabase/functions/_shared/schedule.ts",
    "supabase/functions/_shared/scoreLineups.ts",
    "supabase/functions/_shared/scoreShared.ts",
    "supabase/functions/_shared/scoringCore.ts",
    "supabase/functions/_shared/season.ts",
    "supabase/functions/_shared/syncScores.ts",
    "types/database.ts"
  ],
  "ignoreDependencies": [
    "agent-browser",
    "cheerio",
    "expo-symbols",
    "expo-updates",
    "npm",
    "prettier"
  ],
  "ignoreBinaries": [
    "psql",
    "security",
    "supabase"
  ]
}
