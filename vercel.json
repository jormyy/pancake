{
  "installCommand": "npm ci",
  "buildCommand": "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 npm run build:web:release",
  "outputDirectory": "dist",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "work/pancake-t_43badb9b-waivers": false
    }
  },
  "routes": [
    {
      "src": "^/(?:_expo/static|assets)/.*$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:_expo(?:/.*)?|assets(?:/.*)?|.*\\.(?:js|mjs|css|map|json|webmanifest|wasm|woff2?|ttf|otf|png|jpe?g|gif|webp|svg|ico))$",
      "dest": "/asset-not-found.txt",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "text/plain; charset=utf-8",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "^/player/(.*)$",
      "dest": "/player/[id].html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/+not-found.html"
    }
  ]
}
