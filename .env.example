# Local app. Use values from this stack's `supabase status -o env`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:54321/functions/v1/api

# Local Edge calls. Keep the internal token equal to the database dispatch setting.
PANCAKE_SUPABASE_SECRET_KEY=
PANCAKE_EDGE_INTERNAL_TOKEN=

# Local database scripts and benchmark clients.
# Edge receives SUPABASE_URL from its runtime; export it for standalone scripts.
# SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=
# SUPABASE_ANON_KEY=

# Optional admin API access: comma-separated authenticated user IDs.
ADMIN_USER_IDS=

# Local browser and soak setup. An empty admin secret keeps E2E routes closed.
E2E_ADMIN_SECRET=
E2E_FRONTEND_URL=http://127.0.0.1:8082

# Optional Web Push. All three values are required. Generate a pair with npm run generate:vapid-keys.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Player source: espn (default) or the dormant sleeper fallback.
PLAYER_SYNC_SOURCE=espn

# Optional provider overrides for isolated tests. Unset variables keep production endpoint defaults.
# NBA_CDN_BASE_URL=
# NBA_STATS_BASE_URL=
# NBA_COM_BASE_URL=
# ESPN_SITE_BASE_URL=
# ESPN_CAREER_BASE_URL=
# SLEEPER_BASE_URL=
# LIVE_POLL_PROVIDER_URL=
# LIVE_POLL_USE_EDGE=
# EXPO_PUSH_URL=
# EXPO_RECEIPTS_URL=
# EXPO_RECEIPT_DELAY_SECONDS=
