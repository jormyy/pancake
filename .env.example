# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
PANCAKE_SUPABASE_SECRET_KEY=your_dashboard_revealed_sb_secret_key

# Supabase Edge API
EXPO_PUBLIC_API_URL=https://your-project-ref.supabase.co/functions/v1/api

# Supabase Edge internal calls (store real value as a hosted Edge secret and DB setting)
PANCAKE_EDGE_INTERNAL_TOKEN=generate_a_long_random_value
E2E_ADMIN_SECRET=generate_a_long_random_value_for_local_prod_e2e

# E2E upstream seams. Production leaves these unset.
NBA_CDN_BASE_URL=https://cdn.nba.com/static/json
ESPN_SITE_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/nba
SLEEPER_BASE_URL=https://api.sleeper.app/v1

# Player master-list source: espn (default) | sleeper (dormant fallback)
PLAYER_SYNC_SOURCE=espn
