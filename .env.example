# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy fallback only. Prefer EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_legacy_supabase_anon_key

# Backend (Railway)
EXPO_PUBLIC_API_URL=your_railway_backend_url

# E2E upstream seams. Production leaves these unset.
NBA_CDN_BASE_URL=https://cdn.nba.com/static/json
SLEEPER_BASE_URL=https://api.sleeper.app/v1
