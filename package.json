{
  "name": "pancake-init",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:core": "npm run typecheck --workspace core",
    "check:core-cjs": "node scripts/check-core-cjs.mjs",
    "generate:edge-shared": "node scripts/generate-edge-shared.mjs",
    "check:edge-shared": "node scripts/generate-edge-shared.mjs --check",
    "check:edge-functions": "deno check supabase/functions/api/index.ts supabase/functions/sync-scores/index.ts supabase/functions/sync-rankings/index.ts supabase/functions/sync-projections/index.ts supabase/functions/process-waivers/index.ts supabase/functions/process-trades/index.ts supabase/functions/close-expired-nominations/index.ts supabase/functions/lineup-optimizer/index.ts && deno test --allow-env --allow-net --allow-read supabase/functions/api/router.test.ts supabase/functions/sync-rankings/parser.test.ts supabase/functions/sync-rankings/match.test.ts supabase/functions/sync-projections/parser.test.ts supabase/functions/sync-projections/match.test.ts supabase/functions/sync-projections/scoring.test.ts",
    "test": "vitest run",
    "test:db:draft-goal": "psql \"${SUPABASE_DB_URL:?SUPABASE_DB_URL is required}\" --set ON_ERROR_STOP=1 -f tests/db/draft-goal-behavior.sql",
    "test:db:dynasty-ranking": "psql \"${SUPABASE_DB_URL:?SUPABASE_DB_URL is required}\" --set ON_ERROR_STOP=1 -f tests/db/dynasty-ranking-metadata.sql",
    "test:watch": "vitest",
    "test:workspaces": "npm test && npm test --workspace core",
    "e2e:seed": "node tests/e2e/seed-league.mjs",
    "e2e:soak": "node tests/e2e/soak.mjs --seasons=10",
    "e2e:browser-smoke": "node tests/e2e/browser-smoke.mjs",
    "e2e:browser-auth": "node tests/e2e/browser-auth.mjs",
    "e2e:browser-perf": "node tests/e2e/browser-perf-smoke.mjs",
    "e2e:browser-gameplay": "node tests/e2e/browser-gameplay.mjs",
    "e2e:browser-league-lifecycle": "node tests/e2e/browser-league-lifecycle.mjs",
    "e2e:browser-lineup": "node tests/e2e/browser-lineup-gameplay.mjs",
    "e2e:browser-lineup-auto-set": "node tests/e2e/browser-lineup-gameplay.mjs --auto-set",
    "e2e:browser-lineup-locked": "node tests/e2e/browser-lineup-gameplay.mjs --locked",
    "e2e:browser-playoff": "node tests/e2e/browser-playoff-gameplay.mjs",
    "e2e:browser-rookie-draft": "node tests/e2e/browser-rookie-draft-gameplay.mjs",
    "e2e:browser-waiver": "node tests/e2e/browser-waiver-gameplay.mjs",
    "e2e:browser-waiver-drop": "node tests/e2e/browser-waiver-gameplay.mjs --drop",
    "e2e:browser-waiver-ir-block": "node tests/e2e/browser-waiver-gameplay.mjs --ir-block",
    "e2e:browser-trade": "node tests/e2e/browser-trade-gameplay.mjs",
    "e2e:browser-trade-accept": "node tests/e2e/browser-trade-gameplay.mjs --accept",
    "e2e:browser-trade-terminal": "node tests/e2e/browser-trade-gameplay.mjs --terminal",
    "e2e:browser-trade-future-pick": "node tests/e2e/browser-trade-gameplay.mjs --future-pick",
    "e2e:browser-trade-future-pick-accept": "node tests/e2e/browser-trade-gameplay.mjs --future-pick-accept",
    "e2e:browser-trade-overflow-accept": "node tests/e2e/browser-trade-gameplay.mjs --overflow-accept",
    "e2e:browser-trade-post-deadline": "node tests/e2e/browser-trade-gameplay.mjs --post-deadline",
    "e2e:browser-trade-veto": "node tests/e2e/browser-trade-gameplay.mjs --veto",
    "e2e:dynasty-ranking-rpc": "node tests/e2e/dynasty-ranking-rpc.mjs",
    "e2e:web-static": "node tests/e2e/static-web-server.mjs",
    "e2e:fake-upstream": "node tests/e2e/fake-upstream.mjs",
    "prod:check": "node tests/e2e/production-readiness.mjs",
    "prod:data-health": "node tests/e2e/prod-data-source-health.mjs",
    "security:db-catalog": "node tests/e2e/db-security-catalog.mjs",
    "security:edge-auth": "node tests/e2e/edge-internal-auth.mjs",
    "security:edge-auth:linked": "node tests/e2e/edge-internal-auth.mjs --linked",
    "security:local-secrets": "node tests/e2e/local-secret-scan.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.98.0",
    "cheerio": "^1.2.0",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bottom-tabs": "^1.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9",
    "ws": "^8.20.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "fast-uri": "3.1.2",
    "esbuild": "0.28.1",
    "js-yaml": "4.2.0",
    "postcss": "8.5.15",
    "uuid": "11.1.1"
  },
  "private": true,
  "workspaces": [
    "core"
  ]
}
