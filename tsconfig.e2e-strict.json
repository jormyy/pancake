{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "scripts/**/*.mjs",
    "tests/e2e/**/*.mjs"
  ],
  "exclude": [
    "node_modules"
  ]
}
