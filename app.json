{
  "expo": {
    "name": "Pancake",
    "slug": "pancake",
    "version": "2.15.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pancake",
    "userInterfaceStyle": "light",
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "web"
    ]
  }
}
