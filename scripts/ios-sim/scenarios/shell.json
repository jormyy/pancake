        },
        "expected": {
          "route": "/league?tab=settings",
          "selector": "[aria-label^='Share invite code ']"
        }
      }
    ]
  },
  {
    "name": "shell-light-menu",
    "group": "shell-light",
    "from": "/",
    "steps": [
      {
        "action": {
          "tap": "Open menu"
        },
        "expected": {
          "selector": "[role='dialog']:not(:has([aria-label='Playoffs'])) [aria-label='Profile & settings']"
        }
      },
      {
        "name": "close",
        "action": {
          "tap": "Close"
        },
        "expected": {
          "selector": "body:not(:has([role='dialog'])) [aria-label='Open menu']"
        }
      }
    ]
  },
