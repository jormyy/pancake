[
  {
    "name": "shell-light-tabs",
    "group": "shell-light",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "tap": "Roster"
      }
    ],
    "steps": [
      {
        "name": "matchup",
        "action": {
          "tap": "Matchup"
        },
        "expected": {
          "route": "/",
          "text": "{{teamName}}"
        }
      },
      {
        "name": "players",
        "action": {
          "tap": "Players"
        },
        "expected": {
          "route": "/players",
          "selector": "[aria-label^='Open ']:not([aria-label='Open menu'])"
        }
      },
      {
        "name": "filters",
        "action": {
          "tap": "Show filters"
        },
        "expected": {
          "dialog": "Filters"
        }
      },
      {
        "name": "close-filters",
        "action": {
          "tap": "Show 20 players"
        },
        "expected": {
          "route": "/players",
          "selector": "[aria-label^='Open ']:not([aria-label='Open menu'])"
        }
      },
      {
        "name": "trades",
        "action": {
          "tapPrefix": "Trades"
        },
        "expected": {
          "route": "/trades",
          "text": "{{otherTeam}}"
        }
      },
      {
        "name": "league",
        "action": {
          "tap": "League"
        },
        "expected": {
          "route": "/league",
          "text": "E2E Team 1"
        }
      },
      {
        "name": "roster",
        "action": {
          "tap": "Roster"
        },
        "expected": {
          "route": "/roster",
          "selector": "[aria-label^='Open ']:not([aria-label='Open menu'])"
        }
      }
    ]
  },
  {
    "name": "shell-light-boot",
