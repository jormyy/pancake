[
  {
    "name": "shell-light-tabs",
    "group": "shell-light",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "tap": "Roster"
      }
    ],
    "steps": [
      {
        "name": "matchup",
        "action": {
          "tap": "Matchup"
        },
        "expected": {
          "route": "/",
          "text": "{{teamName}}"
        }
      },
      {
        "name": "players",
        "action": {
          "tap": "Players"
        },
        "expected": {
          "route": "/players",
          "selector": "[aria-label^='Open ']:not([aria-label='Open menu'])"
        }
      },
      {
        "name": "trades",
        "action": {
          "tapPrefix": "Trades"
        },
        "expected": {
          "route": "/trades",
          "text": "{{otherTeam}}"
        }
      },
      {
        "name": "league",
        "action": {
          "tap": "League"
        },
        "expected": {
          "route": "/league",
          "text": "E2E Team 1"
        }
      },
      {
        "name": "roster",
        "action": {
          "tap": "Roster"
        },
        "expected": {
          "route": "/roster",
          "selector": "[aria-label^='Open ']:not([aria-label='Open menu'])"
        }
      }
    ]
  },
  {
    "name": "shell-light-menu",
    "group": "shell-light",
    "from": "/",
    "steps": [
      {
        "action": {
          "tap": "Open menu"
        },
        "expected": {
          "selector": "[role='dialog'] [aria-label='Profile & settings']"
        }
      }
    ]
  },
  {
    "name": "shell-light-leagues",
    "group": "shell-light",
    "from": "/",
    "steps": [
      {
        "action": {
          "tap": "Switch league"
        },
        "expected": {
          "selector": "[aria-label^='Switch to ']"
        }
      }
    ]
  },
  {
    "name": "shell-light-modal",
