[
  {
    "name": "taxi-player-tags-light",
    "group": "taxi",
    "from": "/players",
    "prepare": [
      {
        "tap": "Show filters"
      },
      {
        "tapPrefix": "Availability:"
      },
      {
        "tap": "All players"
      },
      {
        "tap": "Close"
      }
    ],
    "steps": [
      {
        "name": "rookie",
        "action": {
          "fill": "Search players",
          "value": "{{freeAgent.display_name}}"
        },
        "expected": {
          "selector": "[aria-label='Open {{freeAgent.display_name}}'] [data-testid='player-eligibility-tags']:has([aria-label='Rookie']):has([aria-label='Taxi eligible'])"
        },
        "note": "Rookie and Taxi tags: years_exp 0, career games 0."
      },
      {
        "name": "under-65",
        "action": {
          "fill": "Search players",
          "value": "{{waiverPlayer.display_name}}"
        },
        "expected": {
          "selector": "[aria-label='Open {{waiverPlayer.display_name}}'] [data-testid='player-eligibility-tags']:has([aria-label='Taxi eligible']):not(:has([aria-label='Rookie']))"
        },
        "note": "Taxi only: years_exp 2, career games 64."
      },
      {
        "name": "veteran",
        "action": {
          "fill": "Search players",
          "value": "{{outPlayer.display_name}}"
        },
        "expected": {
          "selector": "[aria-label='Open {{outPlayer.display_name}}'] [data-testid='player-eligibility-tags']:not(:has([aria-label='Rookie'])):not(:has([aria-label='Taxi eligible']))"
        },
        "note": "Neither tag: years_exp 4, career games 65."
      }
    ],
    "setup": {
      "taxiMember": "{{memberId}}",
      "taxiMode": "tags"
    },
    "theme": "light"
  },
  {
    "name": "taxi-player-detail-light",
    "group": "taxi",
    "from": "/players",
    "prepare": [
      {
        "fill": "Search players",
        "value": "{{freeAgent.display_name}}"
      }
    ],
    "steps": [
      {
        "name": "tags",
        "action": {
          "tap": "Open {{freeAgent.display_name}}"
        },
        "expected": {
          "route": "/player/{{freeAgent.id}}",
          "selector": "[data-testid='player-eligibility-tags']:has([aria-label='Rookie']):has([aria-label='Taxi eligible'])"
        }
      }
    ],
    "setup": {
      "taxiMember": "{{memberId}}",
      "taxiMode": "tags"
    },
    "theme": "light"
  },
  {
    "name": "taxi-add-open-light",
    "group": "taxi",
    "from": "/player/{{freeAgent.id}}",
    "steps": [
      {
        "name": "destinations",
        "action": {
          "tap": "Add {{freeAgent.display_name}}"
        },
        "expected": {
          "selector": "[role='dialog']:has([role='button'][aria-label='Add to taxi']):has([role='button'][aria-label='Add'])"
        }
      },
      {
        "name": "added",
        "action": {
          "tap": "Add to taxi"
        },
        "expected": {
          "text": "{{freeAgent.display_name}} added to taxi."
        }
      },
      {
        "name": "roster",
        "action": {
          "open": "/roster"
        },
        "expected": {
          "selector": "[aria-label='Open {{rosterPlayer.display_name}}']"
        }
      },
      {
        "name": "taxi-section",
        "action": {
          "reveal": "Activate {{freeAgent.display_name}}"
        },
        "expected": {
          "selector": "body:has([aria-label='Taxi squad']) [aria-label='Activate {{freeAgent.display_name}}']"
        },
        "note": "The fixture also checks is_on_taxi in the database before cleanup."
      }
    ],
    "setup": {
      "taxiMember": "{{memberId}}",
      "taxiMode": "open"
    },
    "theme": "light"
  },
  {
    "name": "taxi-add-full-light",
    "group": "taxi",
    "from": "/player/{{freeAgent.id}}",
    "steps": [
      {
        "name": "taxi-without-drop",
        "action": {
          "tap": "Add {{freeAgent.display_name}}"
        },
        "expected": {
          "selector": "[role='dialog']:has([role='button'][aria-label='Add to taxi']):not(:has([role='button'][aria-label='Add']))"
        },
        "note": "Taxi is available without selecting a drop. Preview only; roster stays unchanged."
      }
    ],
    "setup": {
      "taxiMember": "{{memberId}}",
      "taxiMode": "full"
    },
    "theme": "light"
  },
  {
    "name": "taxi-waiver-light",
    "group": "taxi",
    "from": "/player/{{waiverPlayer.id}}",
    "steps": [
      {
        "name": "taxi-default",
        "action": {
          "tap": "Claim {{waiverPlayer.display_name}}"
        },
        "expected": {
          "route": "/claim-player",
          "selector": "[aria-label='Place on taxi']:checked"
        }
      },
      {
        "name": "active-drop",
        "action": {
          "tap": "Place on taxi"
        },
        "expected": {
          "selector": "body:has([aria-label='Place on taxi']:not(:checked)) [aria-label^='Select '][aria-label$=' to drop']"
        },
        "note": "The active roster is full. DROP A PLAYER (required) appears."
      },
      {
        "name": "taxi-no-drop",
        "action": {
          "tap": "Place on taxi"
        },
        "expected": {
          "text": "Place on taxi. No drop required."
        }
      }
    ],
    "setup": {
      "taxiMember": "{{memberId}}",
      "taxiMode": "claim"
    },
    "theme": "light"
  },
  {
    "name": "taxi-illegal-taxi-light",
    "group": "taxi",
    "from": "/players",
    "prepare": [
      {
        "fill": "Search players",
        "value": "{{freeAgent.display_name}}"
      }
    ],
    "steps": [
      {
        "name": "banner",
        "action": {
          "open": "/roster"
        },
        "expected": {
          "selector": "[role='alert'][aria-label='Resolve roster problems']:has([aria-label^='Activate ']):has([aria-label^='Drop '])"
        },
        "note": "The named player no longer qualifies for taxi."
      },
      {
        "name": "blocked-add",
        "action": {
          "sequence": [
            {
              "open": "/players"
            },
            {
              "fill": "Search players",
              "value": "{{freeAgent.display_name}}"
            },
            {
              "tap": "Add {{freeAgent.display_name}}"
            }
          ]
        },
        "expected": {
          "selector": "[role='dialog']:has([aria-label^='Activate ']):has([aria-label^='Drop '])"
        },
        "note": "The fixture checks that roster, transactions, claims, and add counts stay unchanged."
      }
    ],
    "setup": {
      "taxiMember": "{{memberId}}",
      "taxiMode": "illegal-taxi"
    },
    "theme": "light"
  },
  {
    "name": "taxi-illegal-taxi-trade-light",
    "group": "taxi",
    "from": "/trades",
    "steps": [
      {
        "name": "start",
        "action": {
          "sequence": [
            {
              "tap": "Propose trade"
            },
            {
              "reveal": "Trade with {{otherTeam}}"
            }
          ]
        },
        "expected": {
          "route": "/propose-trade",
          "selector": "[aria-label='Trade with {{otherTeam}}']"
        },
        "note": "The current client permits opening the trade editor. It checks roster legality when sending."
      },
      {
        "name": "select",
        "action": {
          "sequence": [
            {
              "tap": "Trade with {{otherTeam}}"
            },
            {
              "tap": "Edit assets sent by {{otherTeam}}"
            },
            {
              "tapPrefix": "Select "
            },
            {
              "tap": "Edit assets sent by you"
            },
            {
              "tap": "Select {{rosterPlayer.display_name}} for trade"
            },
            {
              "reveal": "Remove {{rosterPlayer.display_name}} for trade"
            }
          ]
        },
        "expected": {
          "selector": "[aria-label='Remove {{rosterPlayer.display_name}} for trade']"
        }
      },
      {
        "name": "review",
        "action": {
          "tap": "Review trade proposal"
        },
        "expected": {
          "selector": "[aria-label='Confirm and send trade']:not([aria-disabled='true'])"
        }
      },
      {
        "name": "blocked-send",
        "action": {
          "tap": "Confirm and send trade"
        },
        "expected": {
          "selector": "[role='dialog']:has([aria-label^='Activate ']):has([aria-label^='Drop '])"
        },
        "note": "The fixture checks that no offer or roster change occurs."
      },
      {
        "name": "discard",
        "action": {
          "sequence": [
            {
              "tap": "Close"
            },
            {
              "tap": "Back to trade editor"
            },
            {
              "tap": "Cancel trade proposal"
            },
            {
              "tap": "Discard"
            }
          ]
        },
        "expected": {
          "route": "/trades",
          "selector": "[aria-label='Propose trade']"
        }
      }
    ],
    "setup": {
      "taxiMember": "{{memberId}}",
      "taxiMode": "trade-taxi"
    },
    "theme": "light"
  },
