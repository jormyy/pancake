[
  {
    "name": "player-waiver-ir-submit",
    "group": "player-waiver-award",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/player/{{waiverPlayer.id}}"
      },
      {
        "tap": "Claim {{waiverPlayer.display_name}}"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Submit waiver claim"
        },
        "expected": {
          "text": "Claim Submitted"
        }
      }
    ],
    "setup": {
      "waiverClaimMember": "{{memberId}}",
      "waiverPlayer": "{{waiverPlayer.id}}"
    }
  },
  {
    "name": "player-waiver-healthy-award",
    "group": "player-waiver-award",
    "from": "/roster",
    "steps": [
      {
        "action": {
          "tap": "Open {{waiverPlayer.display_name}}"
        },
        "expected": {
          "selector": "[aria-label=\"Move {{waiverPlayer.display_name}} in lineup\"]"
        },
        "note": "An independent fixture creates an active waiver award and restores the roster after capture."
      }
    ],
    "setup": {
      "waiverAwardMember": "{{memberId}}",
      "waiverPlayer": "{{waiverPlayer.id}}"
    }
  }
]
