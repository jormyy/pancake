[
  {
    "name": "player-controls-light",
    "group": "player-controls",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/players"
      },
      {
        "tap": "Show filters"
      },
      {
        "tapPrefix": "Sort:"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Points"
        },
        "expected": {
          "selector": "[aria-label='Sort: Points']"
        }
      },
      {
        "name": "availability",
        "action": {
          "sequence": [
            {
              "tapPrefix": "Availability:"
            },
            {
              "tap": "On waivers"
            }
          ]
        },
        "expected": {
          "selector": "[aria-label='Availability: On waivers']"
        }
      },
      {
        "name": "results",
        "action": {
          "tap": "Close"
        },
        "expected": {
          "selector": "[aria-label='Claim {{waiverPlayer.display_name}}']"
        }
      }
    ]
  },
  {
    "name": "player-controls-dark",
    "group": "player-controls",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Dark"
      },
      {
        "open": "/players"
      },
      {
        "tap": "Show filters"
      },
      {
        "tapPrefix": "Sort:"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Points"
        },
        "expected": {
          "selector": "[aria-label='Sort: Points']"
        }
      },
      {
        "name": "availability",
        "action": {
          "sequence": [
            {
              "tapPrefix": "Availability:"
            },
            {
              "tap": "On waivers"
            }
          ]
        },
        "expected": {
          "selector": "[aria-label='Availability: On waivers']"
        }
      },
      {
        "name": "results",
        "action": {
          "tap": "Close"
        },
        "expected": {
          "selector": "[aria-label='Claim {{waiverPlayer.display_name}}']"
        }
      }
    ]
  },
  {
    "name": "player-resolution-light",
    "group": "player-controls",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/player/{{freeAgent.id}}"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Add {{freeAgent.display_name}}"
        },
        "expected": {
          "dialog": "Resolve IR status",
          "selector": "[aria-label^='Activate ']"
        },
        "note": "Requires the manager’s IR player to be healthy; restore the injury fixture after capture."
      },
      {
        "name": "drop",
        "action": {
          "tapPrefix": "Activate "
        },
        "expected": {
          "dialog": "Drop to activate",
          "selector": "[aria-label='Drop {{rosterPlayer.display_name}}']"
        }
      }
    ]
  },
  {
    "name": "player-resolution-dark",
    "group": "player-controls",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Dark"
      },
      {
        "open": "/player/{{freeAgent.id}}"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Add {{freeAgent.display_name}}"
        },
        "expected": {
          "dialog": "Resolve IR status",
          "selector": "[aria-label^='Activate ']"
        },
        "note": "Requires the manager’s IR player to be healthy; restore the injury fixture after capture."
      },
      {
        "name": "drop",
