[
  {
    "name": "player-list-light",
    "group": "player-light",
    "from": "/",
    "steps": [
      {
        "action": {
          "tap": "Players"
        },
        "expected": {
          "route": "/players",
          "selector": "[data-testid='player-meta-line'] > [data-testid='player-eligibility-tags']"
        }
      }
    ],
    "theme": "light"
  },
  {
    "name": "player-filters-light",
    "group": "player-light",
    "from": "/players",
    "steps": [
      {
        "action": {
          "tap": "Show filters"
        },
        "expected": {
          "dialog": "Filters"
        }
      },
      {
        "action": {
          "tapPrefix": "Sort:"
        },
        "expected": {
          "dialog": "Sort"
        },
        "name": "sort"
      }
    ],
    "theme": "light"
  },
  {
    "name": "player-search-light",
    "group": "player-light",
    "from": "/players",
    "steps": [
      {
        "action": {
          "fill": "Search players",
          "value": "{{freeAgent.display_name}}"
        },
        "expected": {
          "selector": "[aria-label='Open {{freeAgent.display_name}}']"
        }
      }
    ],
    "theme": "light"
  },
  {
    "name": "player-detail-light",
    "group": "player-light",
    "from": "/players",
    "prepare": [
      {
        "fill": "Search players",
        "value": "{{freeAgent.display_name}}"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Open {{freeAgent.display_name}}"
        },
        "expected": {
          "route": "/player/{{freeAgent.id}}",
          "selector": "body:not(:has([aria-label='Watch player for drops'])):has([data-testid='player-position-line']):has([data-testid='player-summary-line']) [aria-busy='false'] > [data-testid='recent-games-table']"
        }
      }
    ],
    "theme": "light"
  },
  {
    "name": "player-roster-detail-light",
    "group": "player-light",
    "from": "/roster",
    "steps": [
      {
        "action": {
          "tap": "Open {{rosterPlayer.display_name}}"
        },
        "expected": {
          "selector": "[aria-label='View {{rosterPlayer.display_name}} player page']"
        }
      },
      {
        "action": {
          "tap": "View {{rosterPlayer.display_name}} player page"
        },
        "expected": {
          "route": "/player/{{rosterPlayer.id}}",
          "selector": "[data-testid='player-action-slot'] [aria-label='Drop {{rosterPlayer.display_name}}']"
        },
        "name": "page"
      }
    ],
    "theme": "light"
  },
  {
    "name": "player-season-light",
    "group": "player-light",
    "from": "/player/{{rosterPlayer.id}}",
    "prepare": [
      {
        "select": "Season",
        "value": "2027",
        "option": "2026\u201327"
      }
    ],
    "steps": [
      {
        "action": {
          "select": "Season",
          "value": "2026",
          "option": "2025\u201326"
        },
        "expected": {
          "value": {
            "selector": "select[aria-label='Season']",
            "equals": "2026"
          },
          "text": "Recent games",
          "selector": "[aria-busy='false'] > [data-testid='recent-games-table']"
        }
      }
    ],
    "theme": "light"
  },
  {
    "name": "player-drop-light",
    "group": "player-light",
    "from": "/player/{{freeAgent.id}}",
    "steps": [
      {
        "action": {
          "tap": "Add {{freeAgent.display_name}}"
        },
        "expected": {
          "selector": "[aria-label='Drop {{rosterPlayer.display_name}}']"
        }
      }
    ],
    "theme": "light"
  },
  {
    "name": "player-claim-light",
    "group": "player-light",
    "from": "/player/{{waiverPlayer.id}}",
    "steps": [
      {
        "action": {
          "tap": "Claim {{waiverPlayer.display_name}}"
        },
        "expected": {
          "route": "/claim-player",
          "text": "{{waiverPlayer.display_name}}"
        }
      },
      {
        "action": {
          "tap": "Select {{rosterPlayer.display_name}} to drop"
        },
        "expected": {
          "selector": "[aria-label='Submit waiver claim']:not([aria-disabled='true'])"
        },
        "name": "select-drop"
      }
    ],
    "theme": "light"
  },
  {
    "name": "player-out-light",
    "group": "player-light",
    "from": "/players",
    "prepare": [
      {
        "fill": "Search players",
        "value": "{{outPlayer.display_name}}"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Open {{outPlayer.display_name}}"
        },
        "expected": {
          "route": "/player/{{outPlayer.id}}",
          "selector": "[aria-label='Add to IR {{outPlayer.display_name}}']"
        }
      }
    ],
    "theme": "light"
  },
  {
    "name": "player-return-light",
    "group": "player-light",
    "from": "/player/{{rosterPlayer.id}}",
    "steps": [
      {
        "action": {
          "background": true
        },
        "expected": {
          "route": "/player/{{rosterPlayer.id}}",
          "selector": "select[aria-label='Season']"
        }
      }
    ],
    "theme": "light"
  },
