[
  {
    "name": "league-draft-clock-light",
    "group": "league-clock",
    "from": "/",
    "steps": [
      {
        "action": {
          "open": "/draft"
        },
        "expected": {
          "text": "You're leading"
        },
        "note": "The display clock changes once per second. Its text box must not resize.",
        "allowClock": true
      }
    ],
    "setup": {
      "liveAuctionLeader": "{{memberId}}"
    },
    "theme": "light"
  },
  {
    "name": "league-auction-clock-light",
    "group": "league-clock",
    "from": "/",
    "steps": [
      {
        "action": {
          "open": "/draft-room?draftId={{draftId}}"
        },
        "expected": {
          "text": "You're leading"
        },
        "note": "The display clock changes once per second. Its text box must not resize.",
        "allowClock": true
      }
    ],
    "setup": {
      "draftRoom": "auction",
      "draftId": "{{draftId}}",
      "auctionNomination": true
    },
    "theme": "light"
  },
  {
    "name": "league-auction-pause-light",
    "group": "league-clock",
    "from": "/draft-room?draftId={{draftId}}",
    "steps": [
      {
        "action": {
          "tap": "Pause draft"
        },
        "expected": {
          "selector": "[aria-label='Resume draft']"
        },
        "note": "One user tap pauses the server clock."
      },
      {
        "name": "resume",
        "action": {
          "tap": "Resume draft"
        },
        "expected": {
          "selector": "[aria-label='Pause draft']"
        },
        "note": "One user tap resumes the server clock.",
        "allowClock": true
      }
    ],
    "setup": {
      "draftRoom": "auction",
      "draftId": "{{draftId}}",
      "auctionNomination": true
    },
    "theme": "light"
  },
  {
    "name": "league-rookie-pause-light",
