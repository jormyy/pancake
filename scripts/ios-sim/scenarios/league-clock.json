[
  {
    "name": "league-draft-clock-light",
    "group": "league-clock",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/"
      }
    ],
    "steps": [
      {
        "action": {
          "open": "/draft"
        },
        "expected": {
          "text": "You're leading"
        },
        "note": "The display clock changes once per second. Its text box must not resize."
      }
    ]
  },
  {
    "name": "league-auction-clock-light",
    "group": "league-clock",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/"
      }
    ],
    "steps": [
      {
        "action": {
          "open": "/draft-room?draftId={{draftId}}"
        },
        "expected": {
          "text": "You're leading"
        },
        "note": "The display clock changes once per second. Its text box must not resize."
      }
    ],
    "setup": {
      "draftRoom": "auction",
      "draftId": "{{draftId}}",
      "auctionNomination": true
    }
  },
  {
    "name": "league-auction-pause-light",
    "group": "league-clock",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/draft-room?draftId={{draftId}}"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Pause draft"
        },
        "expected": {
          "selector": "[aria-label='Resume draft']"
        },
        "note": "One user tap pauses the server clock."
      },
      {
        "name": "resume",
        "action": {
          "tap": "Resume draft"
        },
        "expected": {
          "selector": "[aria-label='Pause draft']"
        },
        "note": "One user tap resumes the server clock."
      }
    ],
    "setup": {
      "draftRoom": "auction",
      "draftId": "{{draftId}}",
      "auctionNomination": true
    }
  },
