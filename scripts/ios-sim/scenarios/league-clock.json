[
  {
    "name": "league-draft-clock-light",
    "group": "league-clock",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/"
      }
    ],
    "steps": [
      {
        "action": {
          "open": "/draft"
        },
        "expected": {
          "text": "You're leading"
        },
        "note": "The display clock changes once per second. Its text box must not resize."
      }
    ]
  },
  {
    "name": "league-auction-clock-light",
    "group": "league-clock",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/"
      }
    ],
    "steps": [
      {
        "action": {
          "open": "/draft-room?draftId=f3660351-112e-4931-8ece-ea2f33cbdb54"
        },
        "expected": {
          "text": "You're leading"
        },
        "note": "The display clock changes once per second. Its text box must not resize."
      }
    ]
  },
  {
    "name": "league-auction-pause-light",
    "group": "league-clock",
    "from": "/profile",
