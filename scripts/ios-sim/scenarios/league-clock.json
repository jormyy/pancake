      {
        "name": "resume",
        "action": {
          "tap": "Resume draft"
        },
        "expected": {
          "selector": "[aria-label='Pause draft']"
        },
        "note": "One user tap resumes the server clock.",
        "allowClock": true
      }
    ],
    "setup": {
      "draftRoom": "snake",
      "draftId": "{{draftId}}"
    },
    "theme": "light"
  },
  {
    "name": "league-commissioner-tools-light",
    "group": "league-clock",
