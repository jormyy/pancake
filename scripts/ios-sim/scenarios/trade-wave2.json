[
  {
    "name": "trade-roster-plan-light",
    "group": "trade-roster-plan",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/trades"
      }
    ],
    "steps": [
      {
        "action": {
          "tapPrefix": "Show details of trade with "
        },
        "expected": {
          "selector": "body:has([aria-label='Back to trades']) [aria-label='Accept trade with {{otherTeam}}']"
        }
      },
      {
        "name": "invalid-choices",
        "note": "Healthy veterans have no IR or taxi choice. An incoming taxi player must stay on taxi.",
        "action": {
          "tap": "Keegan Carter 19: active"
        },
        "expected": {
          "selector": "body:not(:has([aria-label='Marcus Williams 22: active'],[aria-label='Marcus Williams 22: ir'],[aria-label='Malik Carter 20: ir'],[aria-label='Malik Carter 20: taxi'])) [aria-label='Keegan Carter 19: active'][aria-checked='true']"
        }
      },
      {
        "name": "drops",
        "action": {
          "tap": "Choose drops at trade completion"
        },
        "expected": {
          "text": "Hide drop choices"
        }
      },
      {
        "name": "choose-drop",
        "action": {
          "tap": "Drop Jalen Davis 41 at completion"
        },
        "expected": {
          "selector": "[aria-label='Drop Jalen Davis 41 at completion'][aria-checked='true']"
        }
      },
      {
        "name": "restore-drop",
        "action": {
          "tap": "Drop Jalen Davis 41 at completion"
        },
        "expected": {
          "selector": "[aria-label='Drop Jalen Davis 41 at completion'][aria-checked='false']"
        }
      },
      {
        "name": "close-drops",
        "action": {
          "tap": "Choose drops at trade completion"
        },
        "expected": {
          "text": "Choose drops"
        }
      }
    ]
  },
