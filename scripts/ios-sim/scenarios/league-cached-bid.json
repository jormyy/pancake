[
  {
    "name": "league-cached-bid-light",
    "group": "league-cached-bid",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/draft-room?draftId={{draftId}}"
      }
    ],
    "steps": [
      {
        "action": {
          "open": "/draft-room?draftId={{draftId}}"
        },
        "expected": {
          "selector": "[aria-label='Bid amount']"
        },
        "note": "The cached room opens with the current minimum bid. Only clock digits may change."
      }
    ],
    "setup": {
      "draftRoom": "auction",
      "draftId": "{{draftId}}",
      "auctionNomination": true
    },
    "repeat": 2
  },
