[
  {
    "name": "player-claim-ir-light",
    "group": "player-claim-ir",
    "from": "/player/{{waiverPlayer.id}}",
    "steps": [
      {
        "action": {
          "tap": "Claim {{waiverPlayer.display_name}}"
        },
        "expected": {
          "route": "/claim-player",
          "selector": "[aria-label='Place on IR']"
        }
      },
      {
        "name": "active",
        "action": {
          "tap": "Place on IR"
        },
        "expected": {
          "text": "DROP A PLAYER (required)"
        }
      },
      {
        "name": "ir",
        "action": {
          "tap": "Place on IR"
        },
        "expected": {
          "text": "Place on IR. No drop required."
        }
      }
    ],
    "setup": {
      "waiverIRPlayer": "{{waiverPlayer.id}}"
    },
    "theme": "light"
  },
