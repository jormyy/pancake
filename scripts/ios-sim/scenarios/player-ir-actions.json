      {
        "name": "ir",
        "action": {
          "tap": "Place on IR"
        },
        "expected": {
          "text": "Place on IR. No drop required."
        }
      }
    ]
  },
  {
    "name": "player-ir-shortcut-light",
    "group": "player-ir-shortcut",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/player/{{freeAgent.id}}"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Add {{freeAgent.display_name}}"
        },
        "expected": {
          "selector": "[aria-label=\"Move Jalen Murray 61 to IR and add player\"]"
        }
      }
    ]
  },
  {
    "name": "player-ir-shortcut-dark",
