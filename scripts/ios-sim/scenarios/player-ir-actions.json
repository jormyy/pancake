  {
    "name": "player-straight-to-ir",
    "group": "player-straight-to-ir",
    "from": "/players",
    "prepare": [
      {
        "fill": "Search players",
        "value": "{{outPlayer.display_name}}"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Add to IR {{outPlayer.display_name}}"
        },
        "expected": {
          "text": "{{outPlayer.display_name}} added to IR."
        }
      }
    ]
