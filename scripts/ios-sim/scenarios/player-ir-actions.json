[
  {
    "name": "player-claim-ir-light",
    "group": "player-claim-ir",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/player/{{waiverPlayer.id}}"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Claim {{waiverPlayer.display_name}}"
        },
        "expected": {
          "route": "/claim-player",
          "selector": "[aria-label='Place on IR']"
        }
      },
      {
        "name": "active",
        "action": {
          "tap": "Place on IR"
        },
        "expected": {
          "text": "DROP A PLAYER (required)"
        }
      },
      {
        "name": "ir",
        "action": {
          "tap": "Place on IR"
        },
        "expected": {
          "text": "Place on IR. No drop required."
        }
      }
    ]
  },
  {
    "name": "player-claim-ir-dark",
    "group": "player-claim-ir",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Dark"
      },
      {
        "open": "/player/{{waiverPlayer.id}}"
      }
    ],
