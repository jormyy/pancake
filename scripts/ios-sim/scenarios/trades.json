  },
  {
    "name": "trades-picks-light",
    "group": "trades-light",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/trades"
      }
    ],
    "steps": [
      {
        "action": {
          "open": "/trades?tab=picks"
        },
        "expected": {
          "selector": "body:has([id='trade-section-offers'][aria-selected='true']) [aria-label^='Show details of trade with ']"
        }
      },
      {
        "name": "removed-analyzer",
        "action": {
          "open": "/trades?tab=analyzer"
        },
        "expected": {
          "selector": "body:has([id='trade-section-offers'][aria-selected='true']) [aria-label^='Show details of trade with ']"
        }
      }
    ]
  },
  {
    "name": "trades-composer-light",
    "group": "trades-light",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/trades"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "Propose trade"
        },
        "expected": {
          "route": "/propose-trade",
          "selector": "[aria-label^='Trade with ']"
        }
      },
      {
        "action": {
          "tap": "Trade with {{otherTeam}}"
        },
        "expected": {
          "selector": "[aria-label$=' for trade']"
        },
        "name": "assets"
      },
      {
        "action": {
          "tap": "Select {{rosterPlayer.display_name}} for trade"
        },
        "expected": {
          "selector": "[aria-label='Remove {{rosterPlayer.display_name}} for trade']"
        },
        "name": "analysis"
      },
      {
        "name": "outlook",
        "action": {
          "tap": "Analyze trade proposal"
        },
        "expected": {
          "selector": "[aria-label='Dynasty trade analysis']"
        }
      },
      {
        "name": "back",
        "action": {
          "tap": "Back to trade editor"
        },
        "expected": {
          "selector": "[aria-label='Analyze trade proposal']:not([aria-disabled='true'])"
        }
      },
      {
        "name": "request",
        "action": {
          "sequence": [
            {
              "tap": "Edit assets sent by {{otherTeam}}"
            },
            {
              "tapPrefix": "Select "
            }
          ]
        },
        "expected": {
          "selector": "body:has([aria-label='Edit assets sent by {{otherTeam}}'][aria-selected='true']) [aria-label^='Remove '][aria-label$=' for trade']"
        }
      },
      {
        "action": {
          "tap": "Review trade proposal"
        },
        "expected": {
          "selector": "[aria-label='Confirm and send trade']:not([aria-disabled='true'])"
        },
        "name": "review"
      },
      {
        "name": "discard",
        "action": {
          "sequence": [
            {
              "tap": "Back to trade editor"
            },
            {
              "tap": "Cancel trade proposal"
            },
            {
              "tap": "Discard"
            }
          ]
        },
        "expected": {
          "route": "/trades",
          "selector": "[aria-label^='Show details of trade with ']"
        }
      }
    ]
  },
