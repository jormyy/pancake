      },
      {
        "name": "asset",
        "action": {
          "tap": "Select {{rosterPlayer.display_name}} for trade"
        },
        "expected": {
          "selector": "[aria-label^='Route {{rosterPlayer.display_name}} to ']"
        }
      },
      {
        "name": "discard",
        "action": {
          "sequence": [
            {
              "tap": "Cancel trade proposal"
            },
            {
              "tap": "Discard"
            }
          ]
        },
        "expected": {
          "route": "/trades",
          "selector": "[aria-label^='Show details of trade with ']"
        }
      }
    ]
  },
