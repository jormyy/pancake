  {
    "name": "trades-block-note-light",
    "group": "trades-light",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/trades"
      },
      {
        "tap": "Block"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "List {{rosterPlayer.display_name}} on trade block"
        },
        "expected": {
          "selector": "[aria-label='Edit trade block note for {{rosterPlayer.display_name}}']"
        }
      },
      {
        "name": "edit",
        "action": {
          "tap": "Edit trade block note for {{rosterPlayer.display_name}}"
        },
        "expected": {
          "selector": "textarea[aria-label='Trade block note for {{rosterPlayer.display_name}}']"
        }
      },
      {
        "name": "type",
        "action": {
          "fill": "Trade block note for {{rosterPlayer.display_name}}",
          "value": "Looking for young guards"
        },
        "expected": {
          "value": {
            "selector": "textarea[aria-label='Trade block note for {{rosterPlayer.display_name}}']",
            "equals": "Looking for young guards"
          },
          "selector": "textarea[aria-label='Trade block note for {{rosterPlayer.display_name}}']"
        },
        "note": "Typing and keyboard movement follow the manager\u2019s input."
      },
      {
        "name": "save",
        "action": {
          "tap": "Save note"
        },
        "expected": {
          "selector": "[aria-label='Edit trade block note for {{rosterPlayer.display_name}}']"
        }
      },
      {
        "name": "remove",
        "action": {
          "tap": "Remove {{rosterPlayer.display_name}} from trade block"
        },
        "expected": {
          "text": "No listings yet."
        }
      }
    ]
  },
