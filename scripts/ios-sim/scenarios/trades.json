[
  {
    "name": "trades-offers-light",
    "group": "trades-light",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/"
      }
    ],
    "steps": [
      {
        "action": {
          "open": "/trades"
        },
        "expected": {
          "route": "/trades",
          "selector": "[aria-label^='Show details of trade with ']"
        }
      }
    ]
  },
  {
    "name": "trades-details-light",
    "group": "trades-light",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/trades"
      }
    ],
    "steps": [
      {
        "action": {
          "tapPrefix": "Show details of trade with "
        },
        "expected": {
          "selector": "body:has([aria-label='Back to trades']):not(:has([aria-label='Open menu'])) [aria-label='Accept trade with {{otherTeam}}']"
        }
      },
      {
        "name": "back",
        "action": {
          "tap": "Back to trades"
        },
        "expected": {
          "selector": "body:has([aria-label='Open menu']) [aria-label^='Show details of trade with ']"
        }
      }
    ]
  },
  {
    "name": "trades-history-light",
    "group": "trades-light",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/trades"
      }
    ],
    "steps": [
      {
        "action": {
          "tap": "History"
        },
        "expected": {
          "text": "No completed trades yet."
        }
      }
    ]
  },
  {
    "name": "trades-league-block-light",
    "group": "trades-light",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/trades"
      }
    ],
    "steps": [
      {
        "action": {
          "open": "/trades?tab=league-block"
        },
        "expected": {
          "text": "No league listings yet.",
          "selector": "body:has([id='trade-section-block'][aria-selected='true']) [aria-label^='List '][aria-label$=' on trade block']"
        }
      },
      {
        "name": "legacy-camel-case",
        "action": {
          "open": "/trades?tab=leagueBlock"
        },
        "expected": {
          "selector": "body:has([id='trade-section-block'][aria-selected='true']) [aria-label^='List '][aria-label$=' on trade block']"
        }
      }
    ]
  },
