[
  {
    "name": "league-standings-light",
    "group": "league-light",
    "from": "/",
    "steps": [
      {
        "action": {
          "tap": "League"
        },
        "expected": {
          "route": "/league",
          "text": "E2E Team 1"
        }
      }
    ],
    "theme": "light"
  },
  {
    "name": "league-activity-light",
    "group": "league-light",
    "from": "/league",
    "steps": [
      {
        "action": {
          "tap": "Activity"
        },
        "expected": {
          "route": "/league?tab=history",
          "selector": "[id='league-panel-history'] [style*='32px'][style*='width'][style*='height']"
        }
      }
    ],
    "theme": "light"
  },
  {
    "name": "league-picks-light",
    "group": "league-light",
    "from": "/league",
    "steps": [
      {
        "action": {
          "tap": "Picks"
        },
        "expected": {
          "route": "/league?tab=picks",
          "text": "You own all your picks, 2028–2032"
        }
      },
      {
        "name": "all",
        "action": {
          "tapPrefix": "Show all draft picks,"
        },
        "expected": {
          "selector": "[role='list'][aria-label^='All draft picks,'] [role='listitem']"
        }
      },
      {
        "name": "traded",
        "action": {
          "tapPrefix": "Show traded draft picks,"
        },
        "expected": {
          "text": "No traded picks yet."
        }
      },
      {
        "name": "old-route",
        "action": {
          "open": "/league?tab=draft-board"
        },
        "expected": {
          "route": "/league",
          "text": "You own all your picks, 2028–2032",
          "selector": "[id='league-panel-picks'] [aria-label^='Show my draft picks,']"
        }
      },
      {
        "name": "saved-tab",
        "action": {
          "open": "/league?tab=draftBoard"
        },
        "expected": {
          "route": "/league",
          "text": "You own all your picks, 2028–2032",
          "selector": "[id='league-panel-picks'] [aria-label^='Show my draft picks,']"
        }
      }
    ],
    "theme": "light"
  },
  {
    "name": "league-auctions-light",
    "group": "league-light",
    "from": "/league",
    "steps": [
      {
        "action": {
          "tap": "Draft"
        },
        "expected": {
          "route": "/league?tab=draft",
          "selector": "[aria-label='Join Auction Draft']"
        }
      },
      {
        "name": "old-route",
        "action": {
          "open": "/league?tab=auctions"
        },
