[
  {
    "name": "league-auction-bidder-light",
    "group": "league-member",
    "from": "/",
    "steps": [
      {
        "action": {
          "open": "/draft-room?draftId={{draftId}}"
        },
        "expected": {
          "selector": "input[aria-label='Bid amount']:not([readonly]):not(:disabled)"
        },
        "quietMs": 400
