[
  {
    "name": "league-auction-bidder-light",
    "group": "league-member",
    "from": "/profile",
    "prepare": [
      {
        "tap": "Light"
      },
      {
        "open": "/"
      }
    ],
    "steps": [
      {
        "action": {
          "open": "/draft-room?draftId={{draftId}}"
        },
        "expected": {
          "selector": "input[aria-label='Bid amount']:not([readonly]):not(:disabled)"
        },
        "quietMs": 400
      }
    ],
    "setup": {
      "draftRoom": "auction",
      "draftId": "{{draftId}}",
      "auctionNomination": true
    }
  },
  {
    "name": "league-rookie-spectator-light",
    "group": "league-member",
    "from": "/profile",
    "prepare": [
