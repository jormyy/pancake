      }
    ],
    "steps": [
      {
        "action": {
          "open": "/rookie-draft-room?draftId={{draftId}}"
        },
        "expected": {
          "selector": "[aria-label='E2E Player001']"
        }
      }
    ],
    "setup": {
      "draftRoom": "snake",
      "draftId": "{{draftId}}"
    }
  },
