{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": [
    "scripts/**/*.mjs",
    "tests/e2e/**/*.mjs",
    "tests/e2e/form-submission-update-globals.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
