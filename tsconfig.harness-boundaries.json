{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "tests/e2e/browser-scenario-manifest.mjs",
    "tests/e2e/browser-scenario-lifecycle.mjs",
    "tests/e2e/scenario-resource-owner.mjs"
  ],
  "exclude": [
    "node_modules"
  ]
}
